# Copy to .env and fill in.

# n8n: the production webhook URL of the "NestEgg: normalise product listing" workflow.
# Leave blank to use the basic built-in parser instead.
N8N_NORMALISE_URL=http://localhost:5678/webhook/normalise-product

# HorizonNet (optional; without it, use "Enter measurements" or the sample room)
# HORIZONNET_DIR=/absolute/path/to/HorizonNet
# HORIZONNET_CKPT=/absolute/path/to/HorizonNet/ckpt/resnet50_rnn__mp3d.pth
# HORIZONNET_PYTHON=/absolute/path/to/HorizonNet/.venv/bin/python
